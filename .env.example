# ---------------------------------------------------------------------------
# AIOps Platform — Environment Variables
# Copy this to .env and fill in your real values.
# Never commit .env to version control.
# ---------------------------------------------------------------------------

# Alerting — Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Alerting — PagerDuty
PAGERDUTY_ROUTING_KEY=YOUR_PAGERDUTY_INTEGRATION_KEY

# Grafana
GRAFANA_API_TOKEN=YOUR_GRAFANA_API_TOKEN

# Anomaly Detection
DETECTION_INTERVAL_SECONDS=60
CONTAMINATION=0.02

# Internal service URLs (override if running outside Docker Compose)
# PROMETHEUS_URL=http://localhost:9090
# DATABASE_URL=postgresql://postgres:password@localhost:5432/aiops
# GRAFANA_URL=http://localhost:3000
